{
    "name": "getodden/crm-core",
    "description": "Headless CRM Core Engine for Odden (Contacts, Companies, Custom Properties, Associations, Timeline)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crm",
        "getodden",
        "contacts",
        "companies",
        "custom-properties",
        "headless"
    ],
    "homepage": "https://odden.io",
    "support": {
        "issues": "https://github.com/getodden/crm/issues",
        "source": "https://github.com/getodden/crm"
    },
    "authors": [
        {
            "name": "CaskStack, LLC",
            "homepage": "https://odden.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Odden\\Core\\": "src/",
            "Odden\\Core\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Odden\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Odden\\Core\\CoreServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
